---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Carta Moka - Descubre nuestro menú de hamburguesas, pastas y bebidas frescas. Ordena ahora." />
		<meta name="theme-color" content="#000000" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Cafe Moka" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href="https://carta-moka.vercel.app/" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph (Facebook, WhatsApp, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Carta Moka" />
		<meta property="og:description" content="Descubre nuestro menú de hamburguesas, pastas y bebidas frescas. Ordena ahora." />
		<meta property="og:url" content="https://carta-moka.vercel.app/" />
		<meta property="og:image" content="https://carta-moka.vercel.app/moka_logo.png" />
		<meta property="og:site_name" content="Cafe Moka" />
		<meta property="og:locale" content="es_CO" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Carta Moka" />
		<meta name="twitter:description" content="Descubre nuestro menú de hamburguesas, pastas y bebidas frescas." />
		<meta name="twitter:image" content="https://carta-moka.vercel.app/moka_logo.png" />

		<!-- Mobile / PWA -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="format-detection" content="telephone=no" />
		<link rel="preload" href="/fonts/Rubik-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />

		<title>Carta Moka</title>
		<ClientRouter />
	</head>
	<body class="font-rubik">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: var(--color-tertiary); 
		scroll-behavior: smooth;
	
	}
</style>
