export function getStaticPaths() {
    return datas.map((data) => ({
        params: { id: data.id.toString() },
        props: { data }
    }))
}

const { data } = Astro.props

const categoriaColors: Record<string, string> = {
    "Hamburguesas": "bg-amber-500/20 text-amber-400 border-amber-500/30",
    "Pastas": "bg-orange-500/20 text-orange-400 border-orange-500/30",
    "Bebidas Frías": "bg-sky-500/20 text-sky-400 border-sky-500/30",
    "Bebidas Calientes": "bg-rose-500/20 text-rose-400 border-rose-500/30",
    "Panes de la Casa": "bg-yellow-500/20 text-yellow-400 border-yellow-500/30",
    "Más Bebidas": "bg-cyan-500/20 text-cyan-400 border-cyan-500/30",
    "Para Acompañar": "bg-lime-500/20 text-lime-400 border-lime-500/30",
    "Desayunos": "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
    "Asados": "bg-red-500/20 text-red-400 border-red-500/30",
    "Adiciones": "bg-violet-500/20 text-violet-400 border-violet-500/30",
};

const badgeClass = categoriaColors[data.categoria] || "bg-white/10 text-white/60 border-white/20";
---
<Layout>
  <main class="min-h-screen bg-tertiary flex flex-col">

    <!-- Imagen hero -->
    <div class="relative w-full overflow-hidden">
      <div class="relative aspect-[4/3] sm:aspect-[16/10] max-h-[65vh]">
        {data.image ? (
          <img 
            src={data.image} 
            alt={data.name} 
            transition:name={`product-img-${data.id}`}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-white/5 to-white/[0.02]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        )}
        <!-- Degradado inferior -->
        <div class="absolute inset-0 bg-linear-to-t from-tertiary via-tertiary/20 to-transparent"></div>
      </div>

      <!-- Botón volver flotante -->
      <a 
        href="/#productos" 
        class="absolute top-4 left-4 z-20 flex items-center gap-2 px-4 py-2.5 rounded-full bg-black/40 backdrop-blur-md text-white/80 hover:text-white hover:bg-black/60 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary/50 cursor-pointer border border-white/10"
        aria-label="Volver al menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="text-sm font-medium hidden sm:inline">Menú</span>
      </a>
    </div>

    <!-- Info del producto -->
    <div class="flex flex-col gap-4 px-5 -mt-6 relative z-10 pb-28 max-w-2xl mx-auto w-full">

      <!-- Badge de categoría -->
      <div>
        <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold border ${badgeClass}`}>
          {data.categoria}
        </span>
      </div>

      <!-- Nombre -->
      <h1 
        transition:name={`product-title-${data.id}`}
        class="text-3xl sm:text-4xl font-bold text-white leading-tight tracking-tight"
      >
        {data.name}
      </h1>

      <!-- Precio -->
      <div class="flex items-baseline gap-2 mt-1">
        <span class="text-white/40 text-lg font-medium">$</span>
        <p 
          transition:name={`product-price-${data.id}`}
          class="text-white font-extrabold text-4xl sm:text-5xl tracking-tight"
        >
          {data.price}
        </p>
      </div>

      <!-- Descripción -->
      {data.description && (
        <div class="mt-2 p-4 rounded-2xl bg-white/[0.04] border border-white/[0.06]">
          <p class="text-white/50 text-sm leading-relaxed">
            {data.description}
          </p>
        </div>
      )}

      <!-- Opciones de Combo -->
      {data.combo && data.combo.length > 0 && (
        <div class="mt-4">
          <h3 class="text-white/40 font-semibold text-xs uppercase tracking-widest mb-3">Elige tu opción</h3>
          <div class="flex flex-col gap-2.5">
            {data.combo.map((option) => (
              <button 
                class="flex justify-between items-center rounded-2xl px-5 py-4 border border-white/[0.08] bg-white/[0.03] hover:bg-white/[0.08] hover:border-white/[0.15] active:scale-[0.98] transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary/50 group"
                aria-label={`Seleccionar ${option.name} - $${option.price}`}
              >
                <span class="text-white font-medium text-base group-hover:text-white transition-colors duration-200">{option.name}</span>
                <span class="text-white/60 font-bold text-base group-hover:text-white transition-colors duration-200">${option.price}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Footer info -->
      <div class="mt-6 pt-6 border-t border-white/[0.06] flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-white/25 text-xs leading-relaxed">
          Producto preparado al momento con los mejores ingredientes. Disponible para consumo en el local.
        </p>
      </div>
    </div>

  </main>
</Layout>