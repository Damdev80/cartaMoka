---
import Layout from '../../layouts/Layout.astro';

interface MokaProduct {
  id: number;
  name: string;
  image: string;
  price: string;
}

export const datas: MokaProduct[] = [
    {
        id: 1,
        name: "Hamburguesa Moka Chep",
        image: "/img/moka/HAMBURGUESA MOKA CHEP.PNG",
        price: "8.50"
    },
    {
        id: 2,
        name: "Hamburguesa Moka Doble Carne",
        image: "/img/moka/HAMBURGUESA MOKA DOBLE CARNE.PNG",
        price: "12.99"
    },
    {
        id: 3,
        name: "Jugo de Mora",
        image: "/img/moka/JUGOO DE MORA.png",
        price: "3.25"
    },
    {
        id: 4,
        name: "Limonada de Coco",
        image: "/img/moka/LIMONADA DE COCO.png",
        price: "3.75"
    },
    {
        id: 5,
        name: "Maracuyá",
        image: "/img/moka/MARACUYA.png",
        price: "3.50"
    },
    {
        id: 6,
        name: "Milo Frío",
        image: "/img/moka/MILO FRIO.png",
        price: "2.99"
    },
    {
        id: 7,
        name: "Pasta Carbonara",
        image: "/img/moka/PASTA CARBONARA.PNG",
        price: "9.75"
    },
    {
        id: 8,
        name: "Pastas de la Casa",
        image: "/img/moka/PASTAS DE LA CASA.PNG",
        price: "10.25"
    },
    {
        id: 9,
        name: "Pastas Especial Moka",
        image: "/img/moka/PASTAS ESPECIAL MOKA.PNG",
        price: "11.50"
    },
    {
        id: 10,
        name: "Pastas Pollo Champiñón",
        image: "/img/moka/PASTAS POLLO CHAMPIÑON.PNG",
        price: "10.99"
    }
];

export function getStaticPaths() {
    return datas.map((data) => ({
        params: { id: data.id.toString() },
        props: { data }
    }))
}

const { data } = Astro.props
---
<Layout>
  <main class="min-h-screen bg-tertiary flex flex-col">
    
    <!-- Imagen hero con overlay y botón volver -->
    <div class="relative w-full aspect-square max-h-[65vh] overflow-hidden">
      <img 
        src={data.image} 
        alt={data.name} 
        transition:name={`product-img-${data.id}`}
        loading="eager"
        decoding="sync"
        class="w-full h-full rounded-2xl object-contain"
      />

      <!-- Degradado sobre la imagen -->
      <div class="absolute inset-0 bg-gradient-to-t from-tertiary via-transparent to-tertiary/60"></div>

      <!-- Botón volver flotante -->
      <a 
        href="/" 
        class="absolute top-4 left-4 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-sm text-white/80 hover:text-white hover:bg-black/60 transition-all duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    </div>

    <!-- Info del producto -->
    <div class="flex flex-col gap-3 px-5 -mt-8 relative z-10 pb-28">
      <h1 
        transition:name={`product-title-${data.id}`}
        class="text-2xl font-bold text-white leading-tight"
      >
        {data.name}
      </h1>

      <p 
        transition:name={`product-price-${data.id}`}
        class="text-white/50 font-extrabold text-3xl"
      >
        ${data.price}
      </p>

      <p class="text-white/30 text-sm leading-relaxed mt-2">
        Producto preparado al momento con los mejores ingredientes. 
        Disponible para consumo en el local.
      </p>
    </div>

    <!-- Botón fijo abajo -->
    <div class="fixed bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-tertiary via-tertiary to-transparent pt-8">
      <button class="w-full py-4 bg-white text-tertiary font-bold text-base rounded-2xl active:scale-95 transition-transform duration-150">
        Ordenar ahora
      </button>
    </div>

  </main>
</Layout>