export function getStaticPaths() {
    return datas.map((data) => ({
        params: { id: data.id.toString() },
        props: { data }
    }))
}

const { data } = Astro.props
---
<Layout>
  <main class="min-h-screen bg-tertiary flex flex-col justify-center ">
    
    <!-- Imagen hero con overlay y botón volver -->
    <div class="relative w-full aspect-square max-h-[70vh] overflow-hidden">
      <img 
        src={data.image} 
        alt={data.name} 
        transition:name={`product-img-${data.id}`}
        loading="eager"
        decoding="sync"
        class="w-full h-full rounded-2xl object-contain"
      />

      <!-- Degradado sobre la imagen -->
      <div class="absolute inset-0 bg-linear-to-t from-tertiary via-transparent to-tertiary/60"></div>

      <!-- Botón volver flotante -->
      <a 
        href="/#productos" 
        class="absolute top-4 left-4 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-sm text-white/80 hover:text-white hover:bg-black/60 transition-all duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    </div>

    <!-- Info del producto -->
    <div class="flex flex-col gap-3 px-5 -mt-8 relative z-10 pb-28">
      <h1 
        transition:name={`product-title-${data.id}`}
        class="text-2xl font-bold text-white leading-tight"
      >
        {data.name}
      </h1>

      <p 
        transition:name={`product-price-${data.id}`}
        class="text-white/50 font-extrabold text-3xl"
      >
        ${data.price}
      </p>

      {data.combo && (
        <div class="mt-6 border-t border-white/20 pt-6">
          <h3 class="text-white font-bold text-lg mb-4">Opciones de Combo</h3>
          <div class="flex flex-col gap-3">
            {data.combo.map((option) => (
              <div class="flex justify-between items-center bg-primary/10 rounded-lg p-4 border border-primary/30">
                <span class="text-white font-semibold">{option.name}</span>
                <span class="text-primary font-bold text-lg">${option.price}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <p class="text-white/30 text-sm leading-relaxed mt-2">
        Producto preparado al momento con los mejores ingredientes. 
        Disponible para consumo en el local.
      </p>
    </div>

    <!-- Botón fijo abajo -->

  </main>
</Layout>