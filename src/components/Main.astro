---
import Card from "./Card.astro";
import { datas } from "../pages/producto/[id].astro";
---

<main class="w-full min-h-screen grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols- gap-4 justify-center items-center bg-tertiary p-4">
    {datas.map((item) => (
        <div class="overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105 [&_img]:w-full [&_img]:h-64 [&_img]:object-cover [&_img]:rounded-t-2xl">
            <Card
            id={item.id} 
            title={item.name} 
            price={parseFloat(item.price)} 
            image={item.image} 
            button="Ordena Ahora"/>
        </div>
    ))}
</main>