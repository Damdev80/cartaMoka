---
import Card from "./Card.astro";
import { datas } from "../pages/producto/[id].astro";

// Extraer categorías únicas
const categorias = ["Todas", ...Array.from(new Set(datas.map(item => item.categoria)))];
---

<main id="productos" class="w-full min-h-screen bg-tertiary px-4 py-12">
    <div class="max-w-6xl mx-auto">
        <!-- Filtros de Categoría -->
        <div class="mb-8 flex flex-wrap gap-3 justify-center">
            {categorias.map((categoria) => (
                <button 
                    data-categoria={categoria}
                    class="filtro-btn px-6 py-2.5 rounded-full font-semibold text-sm transition-all duration-300 hover:scale-105 active:scale-95
                           bg-primary/20 text-primary hover:bg-primary hover:text-white
                           data-[active=true]:bg-primary data-[active=true]:text-white"
                    data-active={categoria === "Todas" ? "true" : "false"}
                >
                    {categoria}
                </button>
            ))}
        </div>

        <!-- Grid de Productos -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="productos-grid">
            {datas.map((item) => (
                <div data-categoria={item.categoria} class="producto-item">
                    <Card
                        id={item.id} 
                        title={item.name} 
                        price={parseFloat(item.price)} 
                        image={item.image}
                    />
                </div>
            ))}
        </div>
    </div>
</main>

<script>
    // Función para inicializar los filtros
    function initFiltros() {
        const filtros = document.querySelectorAll('.filtro-btn');
        const productos = document.querySelectorAll('.producto-item');

        filtros.forEach(filtro => {
            filtro.addEventListener('click', () => {
                const categoriaSeleccionada = filtro.getAttribute('data-categoria');

                // Actualizar botones activos
                filtros.forEach(btn => btn.setAttribute('data-active', 'false'));
                filtro.setAttribute('data-active', 'true');

                // Filtrar productos
                productos.forEach(producto => {
                    const categoriaProducto = producto.getAttribute('data-categoria');
                    const productoElement = producto as HTMLElement;
                    
                    if (categoriaSeleccionada === 'Todas' || categoriaProducto === categoriaSeleccionada) {
                        productoElement.style.display = 'block';
                        // Animación de entrada
                        productoElement.style.animation = 'fadeIn 0.3s ease-in-out';
                    } else {
                        productoElement.style.display = 'none';
                    }
                });
            });
        });
    }

    // Inicializar en carga inicial
    initFiltros();

    // Reinicializar después de cada navegación con view transitions
    document.addEventListener('astro:page-load', () => {
        initFiltros();
        
        // Si hay hash en la URL (ej: /#productos), hacer scroll suave
        if (window.location.hash === '#productos') {
            setTimeout(() => {
                const productosSection = document.getElementById('productos');
                if (productosSection) {
                    productosSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 100);
        }
    });
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>