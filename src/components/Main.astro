---
import Card from "./Card.astro";
import { datas } from "../pages/producto/[id].astro";

// Mapeo de categorías padre → subcategorías
const parentMap: Record<string, string[]> = {
    "Bebidas": ["Todas", "Bebidas Frías", "Bebidas Calientes", "Más Bebidas"],
    "Comidas": ["Todas", "Hamburguesas", "Pastas", "Panes de la Casa", "Para Acompañar", "Desayunos", "Almuerzos Ejecutivos", "Asados"],
    "Adiciones": ["Todas", "Adiciones"],
};

const parentCategories = ["Todas", "Bebidas", "Comidas", "Adiciones"];
---

<main id="productos" class="w-full min-h-screen bg-tertiary px-4 py-12">
    <div class="max-w-6xl mx-auto">

        <!-- Filtros padre -->
        <div id="parent-filters" class="mb-4 flex flex-wrap gap-3 justify-center">
            {parentCategories.map((cat) => (
                <button 
                    data-parent={cat}
                    class="parent-btn px-6 py-3 rounded-full font-semibold text-sm transition-all duration-200 cursor-pointer
                           bg-primary/20 text-primary hover:bg-primary hover:text-white hover:shadow-lg
                           data-[active=true]:bg-primary data-[active=true]:text-white data-[active=true]:shadow-lg
                           focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary focus:ring-offset-tertiary
                           active:scale-95 min-h-12"
                    data-active={cat === "Todas" ? "true" : "false"}
                    aria-pressed={cat === "Todas" ? "true" : "false"}
                >
                    {cat}
                </button>
            ))}
        </div>

        <!-- Sub-filtros -->
        <div id="sub-filters" class="mb-10 flex flex-wrap gap-2 justify-center hidden">
        </div>

        <!-- Grid de Productos -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="productos-grid">
            {datas.map((item) => (
                <div 
                    data-categoria={item.categoria} 
                    data-parent={item.parentCategory}
                    class="producto-item"
                >
                    <Card
                        id={item.id} 
                        title={item.name} 
                        price={item.price} 
                        image={item.image}
                    />
                </div>
            ))}
        </div>
    </div>
</main>

<script>
    const STORAGE_KEY = 'mokaFilters';

    const parentMap: Record<string, string[]> = {
        "Bebidas": ["Todas", "Bebidas Frías", "Bebidas Calientes", "Más Bebidas"],
        "Comidas": ["Todas", "Hamburguesas", "Pastas", "Panes de la Casa", "Para Acompañar", "Desayunos", "Almuerzos Ejecutivos", "Asados"],
        "Adiciones": ["Todas", "Adiciones"],
    };

    let selectedParent = "Todas";
    let selectedSub = "Todas";

    function saveFilterState() {
        try {
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                parent: selectedParent,
                sub: selectedSub
            }));
        } catch {}
    }

    function loadFilterState(): { parent: string; sub: string } {
        try {
            const saved = sessionStorage.getItem(STORAGE_KEY);
            if (saved) {
                const { parent, sub } = JSON.parse(saved);
                return {
                    parent: parent || 'Todas',
                    sub: sub || 'Todas'
                };
            }
        } catch {}
        return { parent: 'Todas', sub: 'Todas' };
    }

    function renderSubFilters(parent: string, activeSub?: string) {
        const container = document.getElementById('sub-filters');
        if (!container) return;

        if (parent === "Todas") {
            container.classList.add('hidden');
            container.innerHTML = '';
            return;
        }

        const subs = parentMap[parent] || [];
        const currentSub = activeSub || 'Todas';
        container.classList.remove('hidden');
        container.innerHTML = subs.map((sub) => `
            <button 
                data-sub="${sub}"
                class="sub-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer
                       bg-white/[0.06] text-white/50 hover:bg-white/[0.12] hover:text-white/80
                       data-[active=true]:bg-white/[0.15] data-[active=true]:text-white
                       focus:outline-none focus:ring-2 focus:ring-white/20
                       active:scale-95 min-h-10 border border-white/[0.06]"
                data-active="${sub === currentSub ? 'true' : 'false'}"
            >
                ${sub}
            </button>
        `).join('');

        bindSubFilters();
    }

    function applyFilter() {
        const productos = document.querySelectorAll('.producto-item');

        productos.forEach((producto) => {
            const cat = producto.getAttribute('data-categoria') || '';
            const parent = producto.getAttribute('data-parent') || '';
            const el = producto;

            let show = false;

            if (selectedParent === "Todas") {
                show = true;
            } else if (selectedSub === "Todas") {
                show = parent === selectedParent;
            } else {
                show = cat === selectedSub;
            }

            el.toggleAttribute('hidden', !show);

            if (show) {
                el.classList.remove('fade-in');
                requestAnimationFrame(() => {
                    el.classList.add('fade-in');
                });
            } else {
                el.classList.remove('fade-in');
            }
        });
    }

    function updateParentButtons() {
        const container = document.getElementById('parent-filters');
        if (!container) return;
        container.querySelectorAll('.parent-btn').forEach((b) => {
            const btn = b as HTMLElement;
            btn.setAttribute('data-active', String(btn.dataset.parent === selectedParent));
        });
    }

    function bindParentFilters() {
        const container = document.getElementById('parent-filters');
        if (!container || container.dataset.bound === 'true') return;
        container.dataset.bound = 'true';

        container.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const btn = target.closest('.parent-btn');
            if (!(btn instanceof HTMLElement)) return;

            const parent = btn.dataset.parent ?? 'Todas';
            selectedParent = parent;
            selectedSub = 'Todas';

            updateParentButtons();
            renderSubFilters(parent);
            applyFilter();
            saveFilterState();
        });
    }

    function bindSubFilters() {
        const container = document.getElementById('sub-filters');
        if (!container) return;

        container.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const btn = target.closest('.sub-btn');
            if (!(btn instanceof HTMLElement)) return;

            const sub = btn.dataset.sub ?? 'Todas';
            selectedSub = sub;

            container.querySelectorAll('.sub-btn').forEach((b) => {
                const isActive = b === btn;
                b.setAttribute('data-active', String(isActive));
            });

            applyFilter();
            saveFilterState();
        });
    }

    function scrollToProductsIfNeeded() {
        if (window.location.hash !== '#productos') return;
        const section = document.getElementById('productos');
        if (!section) return;
        setTimeout(() => {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 80);
    }

    function initFiltros() {
        const saved = loadFilterState();
        selectedParent = saved.parent;
        selectedSub = saved.sub;

        updateParentButtons();
        renderSubFilters(selectedParent, selectedSub);
        applyFilter();
        bindParentFilters();
        scrollToProductsIfNeeded();
    }

    initFiltros();
    document.addEventListener('astro:page-load', initFiltros);
</script>

<style>
    .producto-item {
        content-visibility: auto;
        contain-intrinsic-size: 320px;
    }

    .producto-item[hidden] {
        display: none;
    }

    .producto-item.fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
