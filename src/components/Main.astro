---
import Card from "./Card.astro";
import { datas } from "../pages/producto/[id].astro";

// Extraer categorías únicas
const categorias = ["Todas", ...Array.from(new Set(datas.map(item => item.categoria)))];
---

<main id="productos" class="w-full min-h-screen bg-tertiary px-4 py-12">
    <div class="max-w-6xl mx-auto">
        <!-- Filtros de Categoría -->
        <div id="categorias-filtros" class="mb-12 flex flex-wrap gap-3 justify-center">
            {categorias.map((categoria) => (
                <button 
                    data-categoria={categoria}
                    class="filtro-btn px-6 py-3 rounded-full font-semibold text-sm transition-all duration-200 cursor-pointer
                           bg-primary/20 text-primary hover:bg-primary hover:text-white hover:shadow-lg
                           data-[active=true]:bg-primary data-[active=true]:text-white data-[active=true]:shadow-lg
                           focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary focus:ring-offset-tertiary
                           active:scale-95 min-h-12"
                    data-active={categoria === "Todas" ? "true" : "false"}
                    aria-pressed={categoria === "Todas" ? "true" : "false"}
                >
                    {categoria}
                </button>
            ))}
        </div>

        <!-- Grid de Productos -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="productos-grid">
            {datas.map((item) => (
                <div data-categoria={item.categoria} class="producto-item">
                    <Card
                        id={item.id} 
                        title={item.name} 
                        price={parseFloat(item.price)} 
                        image={item.image}
                    />
                </div>
            ))}
        </div>
    </div>
</main>

<script>
    function applyFilter(selectedCategory) {
        const productos = document.querySelectorAll('.producto-item');

        productos.forEach((producto) => {
            const categoriaProducto = producto.getAttribute('data-categoria');
            const shouldShow = selectedCategory === 'Todas' || categoriaProducto === selectedCategory;
            const productoElement = producto;

            productoElement.toggleAttribute('hidden', !shouldShow);

            if (shouldShow) {
                productoElement.classList.remove('fade-in');
                requestAnimationFrame(() => {
                    productoElement.classList.add('fade-in');
                });
            } else {
                productoElement.classList.remove('fade-in');
            }
        });
    }

    function bindFilters() {
        const filtrosContainer = document.getElementById('categorias-filtros');
        if (!filtrosContainer || filtrosContainer.dataset.bound === 'true') {
            return;
        }

        filtrosContainer.dataset.bound = 'true';

        filtrosContainer.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) {
                return;
            }

            const filtro = target.closest('.filtro-btn');
            if (!(filtro instanceof HTMLElement)) {
                return;
            }

            const categoriaSeleccionada = filtro.dataset.categoria ?? 'Todas';
            const filtros = filtrosContainer.querySelectorAll('.filtro-btn');

            filtros.forEach((btn) => {
                const isActive = btn === filtro;
                btn.setAttribute('data-active', String(isActive));
                btn.setAttribute('aria-pressed', String(isActive));
            });

            applyFilter(categoriaSeleccionada);
        });
    }

    function scrollToProductsIfNeeded() {
        if (window.location.hash !== '#productos') {
            return;
        }

        const productosSection = document.getElementById('productos');
        if (!productosSection) {
            return;
        }

        setTimeout(() => {
            productosSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 80);
    }

    function initFiltros() {
        bindFilters();
        scrollToProductsIfNeeded();
    }

    initFiltros();

    document.addEventListener('astro:page-load', initFiltros);
</script>

<style>
    .producto-item {
        content-visibility: auto;
        contain-intrinsic-size: 320px;
    }

    .producto-item[hidden] {
        display: none;
    }

    .producto-item.fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>