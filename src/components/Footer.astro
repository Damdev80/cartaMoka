---
const currentYear = new Date().getFullYear();
---

<footer class="bg-tertiary border-t border-primary/30 text-white mt-10">
        <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col items-center gap-5 text-center">
                <div class="flex items-center gap-3" aria-label="Redes sociales">
                        <a
                                href="https://www.instagram.com/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-11 h-11 rounded-full border border-primary/50 text-primary hover:bg-primary hover:text-tertiary transition-colors duration-200 flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
                                aria-label="Instagram de Carta Moka"
                        >
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                        <path d="M16 11.37a4 4 0 1 1-2.73-3.83 4 4 0 0 1 2.73 3.83z"></path>
                                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                                </svg>
                        </a>
                        <a
                                href="https://www.facebook.com/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-11 h-11 rounded-full border border-primary/50 text-primary hover:bg-primary hover:text-tertiary transition-colors duration-200 flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
                                aria-label="Facebook de Carta Moka"
                        >
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor">
                                        <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.88 3.78-3.88 1.1 0 2.25.2 2.25.2v2.46H15.2c-1.25 0-1.64.77-1.64 1.57V12h2.8l-.45 2.89h-2.35v6.99A10 10 0 0 0 22 12z"/>
                                </svg>
                        </a>
                        <a
                                href="https://wa.me/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-11 h-11 rounded-full border border-primary/50 text-primary hover:bg-primary hover:text-tertiary transition-colors duration-200 flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
                                aria-label="WhatsApp de Carta Moka"
                        >
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor">
                                        <path d="M20.52 3.48A11.82 11.82 0 0 0 12.04 0C5.5 0 .17 5.33.17 11.87c0 2.08.54 4.1 1.57 5.88L0 24l6.43-1.68a11.8 11.8 0 0 0 5.6 1.43h.01c6.54 0 11.87-5.33 11.88-11.87A11.8 11.8 0 0 0 20.52 3.48zm-8.48 18.3h-.01a9.84 9.84 0 0 1-5-1.37l-.36-.21-3.82 1 1.02-3.72-.24-.38a9.84 9.84 0 0 1-1.5-5.23c0-5.45 4.43-9.88 9.89-9.88a9.8 9.8 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.89 7c0 5.45-4.43 9.88-9.88 9.89zm5.42-7.41c-.3-.15-1.79-.88-2.06-.98-.28-.1-.48-.15-.69.15-.2.3-.79.98-.97 1.19-.18.2-.36.23-.66.08-.3-.15-1.28-.47-2.43-1.5-.9-.8-1.5-1.79-1.68-2.09-.18-.3-.02-.46.14-.61.13-.13.3-.36.45-.54.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.54-.08-.15-.69-1.66-.94-2.27-.25-.6-.5-.52-.69-.53l-.58-.01c-.2 0-.54.08-.82.38-.28.3-1.08 1.05-1.08 2.56s1.1 2.97 1.26 3.17c.15.2 2.16 3.3 5.23 4.62.73.31 1.3.49 1.74.62.73.23 1.4.2 1.92.12.59-.09 1.79-.73 2.05-1.44.25-.71.25-1.31.18-1.44-.08-.13-.28-.2-.58-.35z"/>
                                </svg>
                        </a>
                </div>

                <p class="text-white/80">&copy; {currentYear} Carta Moka. All rights reserved.</p>
                <p class="text-white/60 text-sm">By Daniel Buelvas</p>
        </div>
</footer>
