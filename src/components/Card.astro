---
interface Props {
  title: string;
  price: number;
  image: string;
  button: string;
  id: number;

}
const { title, price, image, button, id } = Astro.props as Props;
---

<a href={`/producto/${id}`} class="block">
  <div class="bg-white rounded-2xl overflow-hidden">
    <img 
      src={image} 
      alt={title} 
      transition:name={`product-img-${id}`}
      class="w-full h-64 object-cover"
    />
    <div class="p-4">
      <h3 
        transition:name={`product-title-${id}`}
        class="text-lg font-bold"
      >
        {title}
      </h3>
      <p 
        transition:name={`product-price-${id}`}
        class="text-gray-600"
      >
        ${price}
      </p>
      <button class="mt-2 bg-primary text-white px-4 py-2 rounded-lg w-full">
        {button}
      </button>
    </div>
  </div>
</a>