---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/images';

interface Props {
  title: string;
  price: string;
  image: string;
  id: number;
}
const { title, price, image, id } = Astro.props as Props;
const resolvedImg = resolveImage(image);
---

<a 
  href={`/producto/${id}`} 
  class="group block cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary rounded-2xl transition-all duration-200"
  aria-label={`${title} - $${price}`}
>
  <div class="relative overflow-hidden rounded-2xl">
    <!-- Imagen -->
    {resolvedImg ? (
      <Image 
        src={resolvedImg} 
        alt={title} 
        transition:name={`product-img-${id}`}
        loading="lazy"
        decoding="async"
        width={320}
        height={320}
        class="w-full aspect-square object-cover group-hover:scale-110 transition-transform duration-300 will-change-transform"
        widths={[320, 640]}
        sizes="(max-width: 640px) 50vw, 320px"
      />
    ) : image ? (
      <img 
        src={image} 
        alt={title} 
        transition:name={`product-img-${id}`}
        loading="lazy"
        decoding="async"
        width="320"
        height="320"
        class="w-full aspect-square object-cover group-hover:scale-110 transition-transform duration-300 will-change-transform"
      />
    ) : (
      <div class="w-full aspect-square flex items-center justify-center bg-gradient-to-br from-white/5 to-white/[0.02]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Overlay degradado mejorado -->
    <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/40 to-black/0 group-hover:from-black/80 transition-colors duration-300"></div>

    <!-- Info sobre la imagen -->
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <h3 
        transition:name={`product-title-${id}`}
        class="text-white font-bold text-sm md:text-base leading-tight line-clamp-2"
      >
        {title}
      </h3>
      <p 
        transition:name={`product-price-${id}`}
        class="text-white/50 font-extrabold text-lg md:text-xl mt-2"
      >
        ${price}
      </p>
    </div>
  </div>
</a>