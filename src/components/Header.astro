---
import '../styles/global.css';
import { animate } from "animejs"
---

<header class="w-full h-screen bg-tertiary flex flex-col justify-center items-center">

  <div id="stars-container" class="absolute inset-0 overflow-hidden">

  </div>

  <div class="w-96 h-96 mt-5 logo-fade">
    <img
    src="/moka_logo.png" 
      alt="CafeMoka logo" 
      transition:animate="fade"
      loading="eager"
      decoding="sync"
    >
  </div>
  <div>
    <a 
      href="#productos" 
      class="flex flex-col items-center gap-2 text-white/60 transition-colors duration-500 animate-bounce header-bounce"
    >
      <span class="text-sm font-medium tracking-widest uppercase">Menú</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</header>

<style>
  .logo-fade {
    animation: smoothFadeIn 1.2s ease-out;
    transition: opacity 0.6s ease-in-out;
  }

  .header-bounce {
    animation: smoothBounce 2s infinite;
  }

  @keyframes smoothFadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes smoothBounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
</style>

<script>
  import { initStarField} from "../utils/stars";
  import { initShooting } from "../utils/shooringStart";

  function initializeHeader() {
    initStarField();
    initShooting();
  }

  initializeHeader();
  
  document.addEventListener('astro:after-swap', () => {
    initializeHeader();
  });
</script>
