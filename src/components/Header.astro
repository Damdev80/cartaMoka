---
import '../styles/global.css';
import { animate } from "animejs"
---

<header class="w-full h-screen bg-tertiary flex flex-col justify-center items-center">

  <div id="stars-container" class="">

  </div>

  <div class="w-96 h-96 mt-5">
    <img
    src="/moka_logo.png" 
      alt="CafeMoka logo" 
      transition:animate="none"
      loading="eager"
      decoding="sync"
    >
  </div>
  <div>
    <a 
      href="#productos" 
      class="flex flex-col items-center gap-2 text-white/60 transition-colors duration-500 animate-bounce"
    >
      <span class="text-sm font-medium tracking-widest uppercase">Menú</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</header>

<script>
  import { initStarField} from "../utils/stars";

  initStarField();
  document.addEventListener('astro:after-swap', () => initStarField());
</script>
